---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
import { STAGES, STAGE_ORDER, sortProjects } from '../../utils/projects';
const projects = sortProjects(await getCollection('projects'));
// Filters are built from the stages that actually appear in the content.
const stages = STAGE_ORDER.map((stage) => ({ stage, label: STAGES[stage], count: projects.filter((project) => project.data.stage === stage).length })).filter((item) => item.count > 0);
---
<BaseLayout title="Projects — YARONG" description="Yarong의 프로젝트 아카이브">
  <div class="page shell reveal">
    <p class="eyebrow">Systems / Tools / Experiments</p><h1 class="page-title">Projects</h1>
    <div class="filters" role="group" aria-label="진행 상태로 거르기" data-filters hidden>
      <button type="button" aria-pressed="true" data-filter="">전체 <span>{projects.length}</span></button>
      {stages.map((item) => <button type="button" aria-pressed="false" data-filter={item.stage}>{item.label} <span>{item.count}</span></button>)}
    </div>
    <p class="count meta" aria-live="polite" data-count>{projects.length} projects</p>
    <ProjectList projects={projects} />
  </div>
</BaseLayout>
<script>
  // Without JavaScript every project is listed and the filter buttons stay hidden.
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-project-list] .project-row'));
  const count = document.querySelector<HTMLElement>('[data-count]');
  if (group) {
    group.hidden = false;
    group.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter ?? '';
      group.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      let shown = 0;
      for (const row of rows) {
        const match = !filter || row.dataset.stage === filter;
        row.hidden = !match;
        if (match) shown++;
      }
      if (count) count.textContent = `${shown} projects`;
    });
  }
</script>
<style>
  .filters { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 1.5rem; }
  .filters[hidden] { display: none; }
  .filters button { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.6rem; padding: 0 1.1rem; border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; cursor: pointer; font: 600 .88rem/1 var(--body); transition: background-color var(--fast), color var(--fast), border-color var(--fast); }
  .filters button span { color: var(--faint); font-weight: 500; }
  .filters button:hover { border-color: var(--muted); background: rgba(var(--light), .08); }
  .filters button[aria-pressed='true'] { border-color: var(--text); background: var(--text); color: var(--bg); }
  .filters button[aria-pressed='true'] span { color: var(--bg); opacity: .65; }
  .count { margin: 0 0 1rem; }
  :global(.project-row[hidden]) { display: none; }
</style>
