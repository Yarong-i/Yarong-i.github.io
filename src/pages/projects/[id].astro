---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchFlow from '../../components/ResearchFlow.astro';
import { stageLabel, projectSummary, reasonLabel } from '../../utils/projects';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({ params: { id: project.id }, props: { project, projects } }));
}
const { project, projects } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const caseStudy = data.caseStudy;
const stage = stageLabel(project);
const summary = projectSummary(project);
const related = data.related.flatMap((id) => projects.filter((item) => item.id === id));
const facts: [string, string][] = [];
if (data.category) facts.push(['Category', data.category]);
if (stage) facts.push(['Status', stage]);
if (data.year !== undefined) facts.push(['Year', String(data.year)]);
if (data.private !== undefined) facts.push(['Source', data.private ? 'Private' : 'Public']);
// Earlier record: the original description (when a newer summary replaced it as the lead) and the Markdown body.
const earlierDescription = data.summary && data.description ? data.description : undefined;
const earlier = data.earlier;
const earlierFacts: [string, string][] = [];
if (earlier?.name) earlierFacts.push(['Name', earlier.name]);
if (earlier?.year !== undefined) earlierFacts.push(['Year', String(earlier.year)]);
if (earlier?.private !== undefined) earlierFacts.push(['Source', earlier.private ? 'Private' : 'Public']);
const hasBody = Boolean(project.body?.trim());
const hasRecord = data.progress.length > 0 || data.result || data.reason || data.versions.length > 0 || related.length > 0 || data.changelog;
---
<BaseLayout title={`${data.title} — YARONG`} description={summary}>
  {caseStudy ? (
    <article class="page case-study reveal">
      <header class="case-hero shell">
        <a class="eyebrow" href="/projects">← Projects</a>
        <h1 class="detail-title">{data.title}</h1>
        <p class="case-subtitle">{caseStudy.subtitle}</p>
        {stage && <p class="stage-line"><span class="stage">{stage}</span></p>}
        <p class="lead">{summary}</p>
      </header>

      {hasRecord && (
        <section class="case-section shell split" aria-labelledby="now-title">
          <div class="section-label"><p class="eyebrow">Now</p><h2 id="now-title">Status</h2></div>
          <dl class="record">
            {data.result && <div><dt>결과</dt><dd>{data.result}</dd></div>}
            {data.reason && <div><dt>{reasonLabel(project)}</dt><dd>{data.reason}</dd></div>}
            {data.progress.length > 0 && <div><dt>경과</dt><dd><ul>{data.progress.map((item) => <li>{item}</li>)}</ul></dd></div>}
          </dl>
        </section>
      )}

      <div class="earlier-head shell">
        <p class="eyebrow">Earlier record</p>
        <h2>기존 연구 기록</h2>
        {data.description && <p>{data.description}</p>}
        <p class="meta">{caseStudy.meta}</p>
      </div>

      <section class="case-section shell split" aria-labelledby="overview-title">
        <div class="section-label"><p class="eyebrow">01 / Context</p><h2 id="overview-title">Overview</h2></div>
        <div class="section-copy">{caseStudy.overview.map((paragraph: string) => <p>{paragraph}</p>)}</div>
      </section>

      <section class="case-section shell split" aria-labelledby="problem-title">
        <div class="section-label"><p class="eyebrow">02 / Friction</p><h2 id="problem-title">Problem</h2></div>
        <ol class="problem-list">{caseStudy.problems.map((problem: string, index: number) => <li><span class="meta">{String(index + 1).padStart(2, '0')}</span><p>{problem}</p></li>)}</ol>
      </section>

      <section class="case-section shell" aria-labelledby="pipeline-title">
        <div class="case-heading"><p class="eyebrow">03 / Process</p><h2 id="pipeline-title">Research Pipeline</h2></div>
        <ResearchFlow study={caseStudy} />
      </section>

      <section class="case-section shell split" aria-labelledby="capabilities-title">
        <div class="section-label"><p class="eyebrow">04 / System</p><h2 id="capabilities-title">Core Capabilities</h2></div>
        <ul class="capability-list">{caseStudy.capabilities.map((capability: string, index: number) => <li><span class="meta">{String(index + 1).padStart(2, '0')}</span><strong>{capability}</strong></li>)}</ul>
      </section>

      <section class="case-section shell" aria-labelledby="principles-title">
        <div class="case-heading"><p class="eyebrow">05 / Criteria</p><h2 id="principles-title">Validation Principles</h2></div>
        <dl class="principles">{caseStudy.principles.map((principle) => <div><dt>{principle.title}</dt><dd>{principle.description}</dd></div>)}</dl>
      </section>

      <section class="safety" aria-labelledby="safety-title">
        <div class="shell safety-inner"><div><p class="eyebrow">06 / Boundary</p><h2 id="safety-title">Safety Boundary</h2></div><ul>{caseStudy.safety.map((item: string) => <li>{item}</li>)}</ul></div>
      </section>

      <section class="case-section shell split" aria-labelledby="technology-title">
        <div class="section-label"><p class="eyebrow">07 / Stack</p><h2 id="technology-title">Technology</h2></div>
        <ul class="technology-list">{data.technologies.map((technology: string) => <li>{technology}</li>)}</ul>
      </section>

      <section class="case-section shell split" aria-labelledby="status-title">
        <div class="section-label"><p class="eyebrow">08 / Then</p><h2 id="status-title">Status at the time</h2></div>
        <ul class="status-list">{caseStudy.status.map((item: string) => <li>{item}</li>)}</ul>
      </section>

      <footer class="closing shell"><p>{caseStudy.closing}</p></footer>
    </article>
  ) : (
    <article class="page shell reveal">
      <a class="eyebrow" href="/projects">← Projects</a>
      <h1 class="detail-title">{data.title}</h1>
      {data.alias && <p class="alias">{data.alias}</p>}
      {facts.length > 0 && <div class="facts">{facts.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}</div>}
      <p class="lead">{summary}</p>
      {data.technologies.length > 0 && <ul class="tag-list">{data.technologies.map((t: string) => <li class="tag">{t}</li>)}</ul>}
      {hasRecord && (
        <dl class="record">
          {data.progress.length > 0 && <div><dt>경과</dt><dd><ul>{data.progress.map((item) => <li>{item}</li>)}</ul></dd></div>}
          {data.result && <div><dt>결과</dt><dd>{data.result}</dd></div>}
          {data.reason && <div><dt>{reasonLabel(project)}</dt><dd>{data.reason}</dd></div>}
          {data.versions.length > 0 && <div><dt>버전</dt><dd><ul>{data.versions.map((version) => <li>{version.name}{version.note && ` — ${version.note}`}</li>)}</ul></dd></div>}
          {related.length > 0 && <div><dt>연결된 프로젝트</dt><dd><ul>{related.map((item) => <li><a class="text-link" href={`/projects/${item.id}/`}>{item.data.title}</a></li>)}</ul></dd></div>}
          {data.changelog && <div><dt>Patch Notes</dt><dd><a class="text-link" href={data.changelog}>변경 기록 보기</a></dd></div>}
        </dl>
      )}
      {(earlierDescription || hasBody || earlier) && (
        <section class="earlier" aria-labelledby="earlier-title">
          <h2 id="earlier-title">{earlier?.name ? `이전 기록 · ${earlier.name}` : '기존 기록'}</h2>
          {earlier && <p class="earlier-note">아래는 이전 프로젝트의 기록이며, 현재 진행 상태를 나타내지 않습니다.</p>}
          {earlierFacts.length > 0 && <div class="facts earlier-facts">{earlierFacts.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}</div>}
          {earlier && earlier.technologies.length > 0 && <ul class="tag-list">{earlier.technologies.map((t: string) => <li class="tag">{t}</li>)}</ul>}
          {earlierDescription && <p class="earlier-description">{earlierDescription}</p>}
          {hasBody && <div class="prose body"><Content /></div>}
        </section>
      )}
    </article>
  )}
</BaseLayout>
<style>
  .detail-title { margin: 2rem 0 clamp(4rem, 9vw, 8rem); max-width: 1100px; font: 500 clamp(3.2rem, 9vw, 8rem)/.9 var(--sans); letter-spacing: -.06em; }
  .alias { margin: -3rem 0 3rem; color: var(--muted); font: 500 clamp(.95rem, 1.4vw, 1.15rem) var(--body); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); border-top: 1px solid var(--line); }
  .facts div { padding: 1.3rem 1.3rem 1.3rem 0; border-bottom: 1px solid var(--line); }
  .facts span, .facts strong { display: block; } .facts span { margin-bottom: .5rem; color: var(--faint); font: 500 .72rem/1.4 var(--label); letter-spacing: .06em; text-transform: uppercase; } .facts strong { font: 600 .95rem/1.4 var(--body); }
  .lead { max-width: 850px; margin: clamp(4rem, 8vw, 7rem) 0 2rem; font: 400 clamp(1.6rem, 4vw, 3.3rem)/1.35 var(--sans); letter-spacing: -.035em; }
  .body { margin-top: clamp(5rem, 10vw, 9rem); }
  .case-study { padding-top: clamp(9rem, 17vw, 14rem); }
  .case-hero { padding-bottom: clamp(6rem, 12vw, 11rem); }
  .case-hero .detail-title { margin-bottom: 1.5rem; text-transform: uppercase; }
  .case-subtitle { margin: 0; font: 400 clamp(1.1rem, 2vw, 1.75rem)/1.3 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--muted); }
  .case-meta { margin: 1.2rem 0 0; }
  .case-hero .lead { max-width: 1050px; margin-bottom: 0; }
  .case-section { padding-block: clamp(5rem, 10vw, 9rem); border-top: 1px solid var(--line); }
  .split { display: grid; grid-template-columns: minmax(15rem, 1fr) minmax(0, 2fr); gap: clamp(3rem, 8vw, 8rem); }
  .section-label h2, .case-heading h2, .safety h2 { margin: 1rem 0 0; font: 500 clamp(2.3rem, 5vw, 4.8rem)/.95 var(--sans); letter-spacing: -.05em; }
  .section-copy { max-width: 760px; }
  .section-copy p { margin: 0 0 2rem; font-size: clamp(1.08rem, 1.5vw, 1.3rem); line-height: 1.9; word-break: keep-all; }
  .problem-list, .capability-list, .technology-list, .status-list, .safety ul { margin: 0; padding: 0; list-style: none; }
  .problem-list { border-top: 1px solid var(--line); }
  .problem-list li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .problem-list p { margin: 0; font-size: clamp(1rem, 1.3vw, 1.16rem); line-height: 1.7; }
  .case-heading { margin-bottom: clamp(3rem, 7vw, 6rem); }
  .capability-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .capability-list li { display: grid; grid-template-columns: 2.5rem 1fr; gap: .5rem; min-height: 115px; padding: 1.3rem; border-bottom: 1px solid var(--line); }
  .capability-list li:nth-child(odd) { border-right: 1px solid var(--line); padding-left: 0; }
  .capability-list strong { font: 400 clamp(.95rem, 1.3vw, 1.12rem)/1.6 var(--body); }
  .principles { margin: 0; border-top: 1px solid var(--line); }
  .principles > div { display: grid; grid-template-columns: minmax(14rem, 1fr) 2fr; gap: 3rem; padding: 1.8rem 0; border-bottom: 1px solid var(--line); }
  .principles dt { font: 500 clamp(1rem, 1.6vw, 1.35rem)/1.4 var(--sans); overflow-wrap: anywhere; }
  .principles dd { margin: 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .safety { background: var(--text); color: var(--bg); }
  .safety-inner { display: grid; grid-template-columns: 1fr 2fr; gap: clamp(3rem, 8vw, 8rem); padding-block: clamp(5rem, 10vw, 9rem); }
  .safety .eyebrow { color: #555550; }
  .safety ul { border-top: 1px solid rgba(8, 8, 8, .35); }
  .safety li { padding: 1.4rem 0; border-bottom: 1px solid rgba(8, 8, 8, .35); font-size: clamp(1rem, 1.5vw, 1.2rem); }
  .technology-list, .status-list { border-top: 1px solid var(--line); }
  .technology-list li, .status-list li { padding: 1.25rem 0; border-bottom: 1px solid var(--line); font: 400 clamp(.9rem, 1.2vw, 1.05rem)/1.5 var(--mono); }
  .status-list li { font-family: var(--body); }
  .closing { padding-block: clamp(7rem, 15vw, 14rem); border-top: 1px solid var(--line); }
  .closing p { max-width: 1100px; margin: 0; font: 500 clamp(2.7rem, 7vw, 7rem)/1.02 var(--sans); letter-spacing: -.055em; word-break: keep-all; }
  @media(max-width: 720px) {
    .split, .safety-inner { grid-template-columns: 1fr; gap: 3rem; }
    .capability-list { grid-template-columns: 1fr; }
    .capability-list li, .capability-list li:nth-child(odd) { min-height: 0; padding: 1.2rem 0; border-right: 0; }
    .principles > div { grid-template-columns: 1fr; gap: .75rem; }
    .case-subtitle { max-width: 18rem; }
    .closing p { font-size: clamp(2.5rem, 12vw, 4rem); }
  }
  .stage-line { margin: 1.5rem 0 0; }
  .stage { display: inline-block; padding: .35rem .8rem; border: 1px solid var(--line-strong); border-radius: 999px; font: 600 .82rem/1.1 var(--body); }
  .record { margin: clamp(3rem, 6vw, 5rem) 0 0; border-top: 1px solid var(--line); }
  .record > div { display: grid; grid-template-columns: minmax(8rem, 14rem) minmax(0, 1fr); gap: 2rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }
  .record dt { color: var(--muted); font: 600 .85rem/1.6 var(--body); }
  .record dd { margin: 0; font-size: clamp(1rem, 1.3vw, 1.1rem); line-height: 1.7; }
  .record ul { margin: 0; padding: 0; list-style: none; display: grid; gap: .4rem; }
  .case-study .record { margin-top: 0; }
  .earlier { margin-top: clamp(5rem, 10vw, 9rem); padding-top: 2rem; border-top: 1px solid var(--line); }
  .earlier h2, .earlier-head h2 { margin: 0; font: 700 clamp(1.4rem, 2.2vw, 2rem)/1.2 var(--display); letter-spacing: -.03em; }
  .earlier-description { max-width: 720px; margin: 1.5rem auto 0; color: var(--muted); font-size: 1.05rem; line-height: 1.8; }
  .earlier .body { margin-top: 2rem; }
  .earlier-note { margin: .75rem 0 0; color: var(--muted); font-size: .95rem; }
  .earlier-facts { margin-top: 1.5rem; }
  .earlier-head { padding-block: clamp(4rem, 8vw, 6rem) 0; border-top: 1px solid var(--line); }
  .earlier-head h2 { margin-top: .8rem; }
  .earlier-head > p:not(.eyebrow):not(.meta) { max-width: 760px; margin: 1.5rem 0 0; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.15rem); line-height: 1.8; }
  .earlier-head .meta { margin-top: 1rem; }
  @media (max-width: 650px) { .record > div { grid-template-columns: minmax(0, 1fr); gap: .4rem; } }
</style>
