---
// Portfolio write-up of a project (src/content/portfolios/<project id>.md). Goal, role and current stage open
// the page; the Markdown body holds the cases and the verification notes.
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { stageLabel } from '../../../utils/projects';

export async function getStaticPaths() {
  const portfolios = await getCollection('portfolios');
  return portfolios.map((portfolio) => ({ params: { id: portfolio.id }, props: { portfolio } }));
}
const { portfolio } = Astro.props;
const project = await getEntry('projects', portfolio.id);
if (!project) throw new Error(`portfolio ${portfolio.id} has no project record`);
const { Content } = await render(portfolio);
const data = portfolio.data;
const recorded = data.recordedAt
  ? new Intl.DateTimeFormat('ko-KR', { dateStyle: 'long', timeZone: 'Asia/Seoul' }).format(data.recordedAt)
  : undefined;
const stage = stageLabel(project);
---
<BaseLayout title={`${project.data.title} 포트폴리오 — YARONG`} description={data.title}>
  <article class="page shell pf">
    <nav class="pf-nav" aria-label="이동">
      <a class="eyebrow" href={`/projects/${project.id}/`}>← {project.data.title} 소개</a>
      <a class="eyebrow" href="/portfolio">전체 포트폴리오</a>
    </nav>
    <p class="pf-kicker">포트폴리오</p>
    <h1 class="pf-title">{data.title}</h1>
    <p class="pf-kind">{data.kind}{recorded && ` · 기록 기준 ${recorded}`}</p>

    <dl class="pf-summary">
      <div><dt>목표</dt><dd>{data.goal}</dd></div>
      <div><dt>역할</dt><dd>{data.role}</dd></div>
      <div><dt>현재 단계</dt><dd>{data.current}</dd></div>
    </dl>
    {data.technologies.length > 0 && (
      <div class="pf-tech"><span>사용 기술·도구</span><ul class="tag-list">{data.technologies.map((t) => <li class="tag">{t}</li>)}</ul></div>
    )}

    <div class="pf-body"><Content /></div>

    <div class="pf-actions">
      <a class="btn btn-ghost" href={`/projects/${project.id}/`}>프로젝트 소개 <span class="arrow" aria-hidden="true">→</span></a>
      {project.data.playUrl && <a class="btn btn-primary" href={project.data.playUrl} target="_blank" rel="noopener">{project.data.playLabel ?? '바로 이용하기'} <span class="arrow" aria-hidden="true">↗</span></a>}
      {stage && <span class="pf-stage">{stage}</span>}
    </div>
  </article>
</BaseLayout>
<style>
  .pf { max-width: 60rem; }
  .pf-nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 1.5rem; }
  .pf-nav a { display: inline-flex; align-items: center; min-height: 2.5rem; }
  .pf-kicker { margin: 1.5rem 0 .4rem; color: var(--faint); font: 600 .8rem var(--body); letter-spacing: .04em; }
  .pf-title { margin: 0; font: 800 clamp(1.9rem, 4.6vw, 3.2rem)/1.15 var(--display); letter-spacing: -.04em; word-break: keep-all; }
  .pf-kind { margin: .9rem 0 0; color: var(--muted); }
  .pf-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; margin: clamp(1.75rem, 4vw, 2.5rem) 0 0; border-top: 2px solid var(--text); }
  .pf-summary > div { padding: 1rem 1.25rem 1.1rem 0; border-bottom: 1px solid var(--line); }
  .pf-summary > div + div { padding-left: 1.25rem; border-left: 1px solid var(--line); }
  .pf-summary dt { margin-bottom: .4rem; color: var(--faint); font: 700 .8rem var(--body); letter-spacing: .04em; }
  .pf-summary dd { margin: 0; font-size: .98rem; line-height: 1.7; }
  .pf-tech { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1rem; margin-top: 1rem; }
  .pf-tech > span { color: var(--faint); font: 600 .8rem var(--body); }
  .pf-tech .tag-list { margin: 0; }
  .pf-body { max-width: 46rem; margin-top: clamp(2rem, 5vw, 3rem); }
  .pf-body :global(h2) { margin: 2.5rem 0 .9rem; padding-top: 1.1rem; border-top: 1px solid var(--line); font: 800 clamp(1.2rem, 2.2vw, 1.5rem)/1.3 var(--display); letter-spacing: -.02em; }
  .pf-body :global(h2:first-child) { margin-top: 0; }
  .pf-body :global(p) { margin: 0 0 1rem; font-size: clamp(1rem, 1.4vw, 1.1rem); line-height: 1.85; }
  .pf-body :global(table) { width: 100%; margin: 1.25rem 0; border-collapse: collapse; font-size: .95rem; font-variant-numeric: tabular-nums; }
  .pf-body :global(th), .pf-body :global(td) { padding: .65rem .6rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .pf-body :global(th) { color: var(--faint); font: 600 .8rem var(--body); border-bottom-color: var(--line-strong); }
  .pf-body :global(td:not(:first-child)), .pf-body :global(th:not(:first-child)) { text-align: right; white-space: nowrap; }
  .pf-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .pf-actions .btn { min-height: 3.1rem; }
  .pf-stage { color: var(--muted); font-size: .9rem; }
  @media (max-width: 760px) {
    .pf-summary { grid-template-columns: 1fr; }
    .pf-summary > div + div { padding-left: 0; border-left: 0; }
    .pf-actions .btn { flex: 1 1 100%; }
  }
</style>
