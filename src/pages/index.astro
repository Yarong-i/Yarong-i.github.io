---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchToday from '../components/ResearchToday.astro';
import { getPerformance, getResearchDays } from '../utils/research';
import { getFeed, FEED_LABEL, formatFeedDate } from '../utils/news';
import { projectSummary, stageLabel } from '../utils/projects';
import { CONTACT, mailto } from '../data/site';

// Home visibility only: retain the coin research page and its entries in the project archive.
const projects = (await getCollection('projects')).filter((p) => p.id !== 'coin-research');
const featured = projects.filter((p) => p.data.featured !== undefined).sort((a, b) => a.data.featured! - b.data.featured!);
const isResearch = (p: (typeof projects)[number]) => /연구|Finance/i.test(p.data.category ?? '');
// "지난 연구" is decided by stage, not by category: only research that is paused, ended or finished.
// Research that is still going (or has no stage) stays with the other projects; nothing is promoted.
const PAST = new Set(['paused', 'ended', 'finished']);
const isPastResearch = (p: (typeof projects)[number]) => isResearch(p) && PAST.has(p.data.stage ?? '');
const CURRENT = new Set(['live', 'operating', 'in-use', 'active']);
// Projects with `wip` (in development) are shown in the project area, not again in "다른 프로젝트".
const wip = projects.filter((p) => p.data.wip).sort((a, b) => a.data.wip!.order - b.data.wip!.order);
const shown = (p: (typeof projects)[number]) => p.data.featured !== undefined || p.data.wip !== undefined;
// "다른 프로젝트": projects that set `home` (in that order), then current research that is not shown above.
const others = [
  ...projects.filter((p) => p.data.home !== undefined && !shown(p) && !isPastResearch(p))
    .sort((a, b) => a.data.home! - b.data.home!),
  ...projects.filter((p) => p.data.home === undefined && !shown(p) && isResearch(p) && CURRENT.has(p.data.stage ?? '')),
];
const pastResearch = projects.filter((p) => isPastResearch(p) && p.data.featured === undefined)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const researchDays = await getResearchDays();
const performance = await getPerformance();
const feed = await getFeed(3);
const game = featured.find((p) => p.data.media);
const bot = featured.find((p) => !p.data.media);
// The project in development shown next to the live game (2D 액션 게임), with its own real build screen.
const dev = wip.find((p) => p.data.wip?.image);
const devShot = dev ? dev.data.screens.find((x) => x.src === dev.data.wip!.image) : undefined;
// The live game: its real factory screen leads its card; the official key art leads the hero.
const gameShot = game?.data.screens[0];
const gameMore = game?.data.screens.slice(1) ?? [];
// Hero visual: only real images - the game's official key art and the 2D game's other real build screen.
const heroBack = game?.data.media;
const heroFront = dev?.data.screens.find((x) => x.src !== dev.data.wip!.image);
// Secondary navigation for the feed: browse by topic.
const topics: ReadonlyArray<readonly [string, string]> = [
  ['/projects/junk-factory/', '게임'], ['/projects/discord-economy-bot/', '봇'], ['/research', '주식 연구'], ['/archive', '전체 기록'],
];
---
<BaseLayout title="YARONG — 게임, 봇, 주식 연구" description="Yarong이 만든 게임과 Discord 봇, 날마다 쌓는 주식 연구 기록, 바로 해 보는 반응속도 테스트.">
  {/* Hero: the big line and real project images. The light behind it moves slowly (static under reduced motion). */}
  <section class="hero" aria-labelledby="hero-h">
    <div class="hero-light" aria-hidden="true"></div>
    <div class="shell hero-in">
      <div class="hero-text">
        <p class="hero-kicker">YARONG · 게임 · 봇 · 주식 연구</p>
        <h1 id="hero-h"><span>만들고, 실험하고,</span> <span>끝까지 <em>플레이</em>합니다.</span></h1>
        <p class="hero-sub">게임과 봇을 만들고, 주식을 연구하는 야롱입니다.</p>
        <div class="hero-actions">
          <a class="btn btn-primary glow-btn" href="/projects">프로젝트 보기 <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="btn btn-ghost" href="/portfolio">포트폴리오</a>
        </div>
      </div>
      {heroBack && (
        <div class="hero-visual">
          <figure class="hv hv-back">
            <img src={heroBack.poster} alt={heroBack.alt} width="1400" height="788" loading="eager" fetchpriority="high" decoding="async" />
            <figcaption>{game!.data.title} · {heroBack.note ?? '대표 이미지'}</figcaption>
          </figure>
          {heroFront && (
            <figure class="hv hv-front">
              <img src={heroFront.src} alt={heroFront.alt} width={heroFront.width} height={heroFront.height} loading="eager" decoding="async" />
              <figcaption>{dev!.data.title} · {heroFront.caption}</figcaption>
            </figure>
          )}
        </div>
      )}
    </div>
  </section>

  {/* Projects: image-led, two sizes. The live game leads; the game in development sits beside it. */}
  <section class="shell projects" aria-labelledby="projects-h">
    <div class="sec-head">
      <h2 id="projects-h">프로젝트</h2>
      <span class="sec-mark" aria-hidden="true">PLAY / CREATE</span>
      <a class="go" href="/projects">전체 프로젝트 <span aria-hidden="true">→</span></a>
    </div>
    <div class="show-grid">
      {game && gameShot && (
        <article class="show show-lead" aria-labelledby={`show-${game.id}`}>
          <a class="show-img" href={gameShot.src} data-lightbox data-caption={gameShot.caption} data-alt={gameShot.alt} aria-label={`${gameShot.caption} — 크게 보기`}>
            <img src={gameShot.src} alt={gameShot.alt} width={gameShot.width} height={gameShot.height} loading="eager" decoding="async" />
            <span class="zoom" aria-hidden="true">크게 보기</span>
          </a>
          <div class="show-body">
            <p class="chip chip-cyan">{stageLabel(game)}</p>
            <h3 id={`show-${game.id}`}><a href={`/projects/${game.id}/`}>{game.data.title}</a>{game.data.alias && <small>{game.data.alias}</small>}</h3>
            <p class="show-sum">{projectSummary(game)}</p>
            {gameMore.length > 0 && (
              <ul class="show-thumbs" aria-label={`${game.data.title} 실제 화면 더 보기`}>
                {gameMore.map((x) => (
                  <li><a href={x.src} data-lightbox data-caption={x.caption} data-alt={x.alt}>
                    <img src={x.src} alt="" width={x.width} height={x.height} loading="lazy" decoding="async" />
                    <span>{x.caption}</span><span class="sr-only"> 크게 보기</span>
                  </a></li>
                ))}
              </ul>
            )}
            <div class="show-actions">
              {game.data.playUrl && <a class="btn btn-primary glow-btn" href={game.data.playUrl} target="_blank" rel="noopener"><span class="tri" aria-hidden="true"></span>{game.data.playLabel ?? '플레이'}<span class="sr-only"> (새 창)</span></a>}
              <a class="go" href={`/projects/${game.id}/`}>프로젝트 소개 <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
      )}
      {dev && devShot && (
        <article class="show show-dev" aria-labelledby={`show-${dev.id}`}>
          <a class="show-img" href={devShot.src} data-lightbox data-caption={devShot.caption} data-alt={devShot.alt} aria-label={`${devShot.caption} — 크게 보기`}>
            <img src={devShot.src} alt={devShot.alt} width={devShot.width} height={devShot.height} loading="eager" decoding="async" />
            <span class="zoom" aria-hidden="true">크게 보기</span>
          </a>
          <div class="show-body">
            <p class="chip chip-gold">{dev.data.wip!.status}</p>
            <h3 id={`show-${dev.id}`}><a href={`/projects/${dev.id}/`}>{dev.data.title}</a></h3>
            <p class="show-sum">{projectSummary(dev)}</p>
            {dev.data.wip!.now && <p class="show-now"><span>현재 작업</span>{dev.data.wip!.now}</p>}
            <p class="show-cap">{devShot.caption}</p>
            <div class="show-actions">
              <a class="go" href={`/projects/${dev.id}/`}>개발 이야기 <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
      )}
    </div>
  </section>

  {/* 롱야봇: a wide band with the description and its real Discord screens. */}
  {bot && (
    <section class="shell bot-band" aria-labelledby="bot-h" data-reveal>
      <div class="bot-in">
        <div class="bot-text">
          <p class="chip chip-violet">{stageLabel(bot)} · Discord</p>
          <h2 id="bot-h"><a href={`/projects/${bot.id}/`}>{bot.data.title}</a></h2>
          <p class="bot-sum">{projectSummary(bot)}</p>
          {bot.data.highlights.length > 0 && <ul class="bot-points" aria-label="대표 기능">{bot.data.highlights.map((h) => <li>{h}</li>)}</ul>}
          {bot.data.notice && <p class="bot-note">{bot.data.notice}</p>}
          <a class="go" href={`/projects/${bot.id}/`}>프로젝트 소개 <span aria-hidden="true">→</span></a>
        </div>
        {bot.data.screens.length > 0 && (
          <ul class="bot-shots" aria-label={`${bot.data.title} 실제 사용 화면`}>
            {bot.data.screens.map((x, i) => (
              <li class:list={[{ main: i === 0 }]}>
                <a href={x.src} data-lightbox data-caption={x.caption} data-alt={x.alt}>
                  <img src={x.src} alt={x.alt} width={x.width} height={x.height} loading="lazy" decoding="async" />
                  <span class="sr-only">크게 보기</span>
                </a>
                <span class="bot-cap">{x.caption}</span>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )}

  {/* 주식 연구: full width and calm - no glow, the table carries it. */}
  <section class="shell research" aria-label="주식 연구" data-reveal>
    <ResearchToday day={researchDays[0]} performance={performance} />
  </section>

  <section class="shell news" aria-labelledby="news-h" data-reveal>
    <div class="news-head"><h2 id="news-h">최근 소식</h2><span class="news-sub">반영한 업데이트</span></div>
    {feed.length > 0 ? (
      <ol class="feed">
        {feed.map((item) => (
          <li>
            <time datetime={item.date.toISOString().slice(0, 10)}>{formatFeedDate(item.date)}</time>
            <span class="kind" data-kind={item.kind}>{FEED_LABEL[item.kind]}</span>
            {item.href ? <a href={item.href}>{item.title}</a> : <span>{item.title}</span>}
          </li>
        ))}
      </ol>
    ) : <p class="empty-note">날짜가 확인된 소식이 생기면 여기에 모입니다.</p>}
    <nav class="topics" aria-label="주제별로 보기">
      <span class="topics-label">주제별</span>
      {topics.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
  </section>

  <section class="shell play-wrap" aria-labelledby="play-h" data-reveal>
    <div class="play">
      <span class="signal" aria-hidden="true"></span>
      <div class="play-text">
        <h2 id="play-h">반응속도 테스트</h2>
        <p>초록으로 바뀌는 순간 눌러 5번의 평균을 재 보세요.</p>
      </div>
      <a class="go play-link" href="/play/reaction">테스트하기 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="shell more" aria-label="다른 프로젝트와 지난 연구" data-reveal>
    <div>
      <div class="more-head"><h2>다른 프로젝트</h2><a class="go" href="/projects">전체 <span aria-hidden="true">→</span></a></div>
      <ul class="plist">
        {others.map((p) => (
          <li><a href={`/projects/${p.id}/`}>
            <strong>{p.data.title}</strong>
            <span class="psum">{projectSummary(p)}</span>
            {stageLabel(p) && <span class="pstage">{stageLabel(p)}</span>}
          </a></li>
        ))}
      </ul>
    </div>
    <div>
      <div class="more-head"><h2>지난 연구</h2><a class="go" href="/research">연구 기록 <span aria-hidden="true">→</span></a></div>
      <ul class="plist research-list">
        {pastResearch.map((p) => (
          <li><a href={`/projects/${p.id}/`}>
            <strong>{p.data.title}</strong>
            <span class="psum">{p.data.result ?? projectSummary(p)}</span>
            {stageLabel(p) && <span class="pstage">{stageLabel(p)}</span>}
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="shell contact" aria-labelledby="contact-h" data-reveal>
    <h2 id="contact-h">같이 만들거나, 물어볼 게 있다면</h2>
    <a class="contact-mail" href={mailto()}>{CONTACT.email}</a>
    <div class="contact-actions">
      <a class="btn btn-primary" href="/contact">문의하기 <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href="/portfolio">포트폴리오</a>
    </div>
  </section>
</BaseLayout>
<style>
  /* Showcase: black ground with cyan / violet / gold light. Effects are concentrated on the hero and the two
     featured projects; the bot band gets a quiet edge, the research and everything below stay calm.
     Under prefers-reduced-motion every movement stops (global rule) and the page is complete without it. */

  /* Hero */
  .hero { position: relative; isolation: isolate; overflow: hidden; padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4.5rem); }
  .hero-light { position: absolute; inset: -20% -10% -10%; z-index: -1; pointer-events: none;
    background:
      radial-gradient(38rem 26rem at 18% 30%, rgba(var(--cyan), .16), transparent 70%),
      radial-gradient(42rem 30rem at 78% 40%, rgba(var(--violet), .2), transparent 70%),
      radial-gradient(30rem 18rem at 60% 95%, rgba(var(--gold), .08), transparent 70%);
    /* Fades out before the section edge, so the light never ends in a visible band. */
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 92%); mask-image: linear-gradient(to bottom, #000 55%, transparent 92%);
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 761px) {
    /* A slow drift of the light (no blinking): about 26 s each way. */
    .hero-light { animation: drift 26s ease-in-out infinite alternate; will-change: transform; }
  }
  @keyframes drift { from { transform: translate3d(-2%, -1%, 0) scale(1); } to { transform: translate3d(2%, 2%, 0) scale(1.06); } }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 4vw, 4rem); }
  .hero-kicker { margin: 0 0 1rem; color: var(--muted); font: 700 .78rem var(--body); letter-spacing: .14em; }
  .hero h1 { margin: 0; font: 800 clamp(2.5rem, 5vw, 4.9rem)/1.06 var(--display); letter-spacing: -.05em; }
  .hero h1 span { display: block; }
  @media (min-width: 1024px) { .hero h1 span { white-space: nowrap; } }
  .hero h1 em { font-style: normal; background: linear-gradient(90deg, rgb(var(--cyan)), rgb(var(--violet))); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero-sub { margin: 1.25rem 0 0; max-width: 34rem; color: var(--text); font: 500 clamp(1.02rem, 1.4vw, 1.2rem)/1.6 var(--body); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.75rem; }
  .hero-actions .btn { min-height: 3.2rem; padding-inline: 1.6rem; }

  /* Buttons on Home: a clear lit ring on hover / focus, a press on :active (global). */
  .glow-btn { transition: color var(--fast), background-color var(--fast), box-shadow var(--base) var(--ease), transform 140ms var(--ease); }
  .glow-btn:hover, .glow-btn:focus-visible { box-shadow: 0 0 0 1px rgba(var(--cyan), .9), 0 10px 32px -10px rgba(var(--cyan), .75); }
  .btn-ghost:hover, .btn-ghost:focus-visible { border-color: rgba(var(--violet), .9); }

  /* Hero images: the game's key art, and a smaller real build screen of the 2D game over its corner. Full images,
     never cropped; their light is a soft edge, not a filter over the picture. */
  /* The front image overlaps only the bottom edge of the key art (about 5% of its height), away from the
     character and the machine, and never covers the key art's caption. */
  .hero-visual { position: relative; padding-bottom: 19%; }
  .hv { position: relative; margin: 0; }
  .hv img { width: 100%; height: auto; border-radius: 16px; }
  .hv-back img { aspect-ratio: 1400 / 788; box-shadow: 0 0 0 1px rgba(var(--cyan), .35), 0 24px 70px -24px rgba(var(--cyan), .55), 0 0 90px -30px rgba(var(--violet), .7); }
  .hv-front { position: absolute; right: -2%; bottom: 0; width: 42%; }
  .hv-front img { aspect-ratio: 16 / 9; border: 1px solid rgba(var(--gold), .55); box-shadow: 0 18px 50px -18px rgba(0, 0, 0, .9), 0 0 40px -12px rgba(var(--gold), .6); }
  .hv figcaption { margin-top: .4rem; color: var(--muted); font: 600 .74rem/1.35 var(--body); }
  .hv-front figcaption { text-shadow: 0 1px 6px #000; }

  /* Section heads */
  .sec-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1.25rem; margin-bottom: clamp(1rem, 2vw, 1.5rem); }
  .sec-head h2 { margin: 0; font: 800 clamp(1.8rem, 3.4vw, 2.8rem)/1.05 var(--display); letter-spacing: -.045em; }
  .sec-mark { color: transparent; -webkit-text-stroke: 1px rgba(var(--light), .28); font: 800 clamp(1.4rem, 3vw, 2.4rem)/1 var(--display); letter-spacing: -.02em; }
  .sec-head .go { margin-left: auto; }

  /* Featured projects: two sizes, image first. */
  .projects { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .show-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(1.25rem, 2.6vw, 2.25rem); align-items: start; }
  .show { --edge: var(--cyan); display: grid; gap: .9rem; min-width: 0; }
  .show-dev { --edge: var(--gold); }
  .show-img { position: relative; display: block; overflow: hidden; border-radius: 16px; background: #000;
    box-shadow: 0 0 0 1px rgba(var(--edge), .35), 0 20px 60px -30px rgba(var(--edge), .6);
    transition: box-shadow var(--base) var(--ease); }
  .show-img img { width: 100%; height: auto; transition: transform 700ms var(--ease); }
  .show-lead .show-img img { aspect-ratio: 1486 / 760; }
  .show-dev .show-img img { aspect-ratio: 16 / 9; }
  .zoom { position: absolute; right: .7rem; bottom: .7rem; padding: .25rem .6rem; border-radius: 999px; background: rgba(9, 10, 13, .78); color: #fff; font: 700 .74rem var(--body); }
  .show:hover .show-img, .show-img:focus-visible { box-shadow: 0 0 0 1px rgba(var(--edge), .95), 0 0 0 4px rgba(var(--edge), .14), 0 24px 70px -24px rgba(var(--edge), .85); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .show:hover .show-img img { transform: scale(1.035); }
  }
  .show-body { display: grid; gap: .55rem; justify-items: start; }
  .chip { margin: 0; padding: .2rem .65rem; border: 1px solid; border-radius: 999px; font: 700 .76rem/1.4 var(--body); }
  .chip-cyan { border-color: rgba(var(--cyan), .6); color: rgb(var(--cyan)); background: rgba(var(--cyan), .08); }
  .chip-gold { border-color: rgba(var(--gold), .6); color: rgb(var(--gold)); background: rgba(var(--gold), .08); }
  .chip-violet { border-color: rgba(var(--violet), .65); color: #C9B3FF; background: rgba(var(--violet), .1); }
  .show h3 { margin: 0; font: 800 clamp(1.7rem, 3vw, 2.6rem)/1.05 var(--display); letter-spacing: -.045em; }
  .show h3 small { display: block; margin-top: .3rem; color: var(--faint); font: 500 .82rem var(--body); letter-spacing: 0; }
  .show-dev h3 { font-size: clamp(1.45rem, 2.4vw, 2rem); }
  .show-sum { margin: 0; max-width: 40rem; color: var(--text); font-size: 1rem; line-height: 1.6; }
  .show-now { display: grid; gap: .1rem; margin: 0; color: var(--muted); font-size: .94rem; line-height: 1.6; }
  .show-now span { color: var(--faint); font: 700 .76rem var(--body); }
  .show-cap { margin: 0; color: var(--faint); font-size: .8rem; }
  .show-thumbs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; width: 100%; margin: .2rem 0 0; padding: 0; list-style: none; }
  .show-thumbs a { display: grid; gap: .3rem; }
  .show-thumbs img { width: 100%; height: auto; aspect-ratio: 16 / 7; object-fit: cover; border: 1px solid var(--line-strong); border-radius: 10px; transition: border-color var(--fast); }
  .show-thumbs span { color: var(--muted); font: 600 .78rem/1.35 var(--body); }
  .show-thumbs a:hover img, .show-thumbs a:focus-visible img { border-color: rgba(var(--cyan), .9); }
  .show-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem 1.25rem; margin-top: .3rem; }
  .show-actions .btn { min-height: 3rem; }
  .tri { width: 0; height: 0; border-block: .38em solid transparent; border-left: .62em solid currentColor; }
  .show:hover .show-actions .go span { transform: translateX(4px); }
  .go { display: inline-flex; align-items: center; gap: .35rem; min-height: 2.75rem; font: 700 .92rem var(--body); }
  .go span { transition: transform var(--base) var(--ease); }
  .go:hover span, .go:focus-visible span { transform: translateX(4px); }
  .go:active { opacity: .75; }

  /* 롱야봇: a wide band. A quiet violet edge, no moving light. */
  .bot-band { margin-top: clamp(3rem, 6vw, 5rem); }
  .bot-in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.25rem, 3vw, 2.75rem); align-items: center;
    padding: clamp(1.25rem, 3vw, 2.25rem); border: 1px solid rgba(var(--violet), .35); border-radius: 20px;
