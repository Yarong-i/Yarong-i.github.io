---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedProject from '../components/home/FeaturedProject.astro';
import ResearchToday from '../components/ResearchToday.astro';
import { getPerformance, getResearchDays } from '../utils/research';
import { getFeed, FEED_LABEL, formatFeedDate } from '../utils/news';
import { projectSummary, stageLabel } from '../utils/projects';
import { NOW } from '../data/now';

const projects = await getCollection('projects');
const featured = projects.filter((p) => p.data.featured !== undefined).sort((a, b) => a.data.featured! - b.data.featured!);
const isResearch = (p: (typeof projects)[number]) => /연구|Finance/i.test(p.data.category ?? '');
// "지난 연구" is decided by stage, not by category: only research that is paused, ended or finished.
// Research that is still going (or has no stage) stays with the other projects; nothing is promoted.
const PAST = new Set(['paused', 'ended', 'finished']);
const isPastResearch = (p: (typeof projects)[number]) => isResearch(p) && PAST.has(p.data.stage ?? '');
const CURRENT = new Set(['live', 'operating', 'in-use', 'active']);
// "다른 프로젝트": projects that set `home` (in that order), then current research that is not featured.
const others = [
  ...projects.filter((p) => p.data.home !== undefined && p.data.featured === undefined && !isPastResearch(p))
    .sort((a, b) => a.data.home! - b.data.home!),
  ...projects.filter((p) => p.data.home === undefined && p.data.featured === undefined && isResearch(p) && CURRENT.has(p.data.stage ?? '')),
];
const pastResearch = projects.filter((p) => isPastResearch(p) && p.data.featured === undefined)
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const nowUpdated = NOW.updated.replace(/-/g, '.');
const researchDays = await getResearchDays();
const performance = await getPerformance();
const feed = await getFeed(3);
const game = featured.find((p) => p.data.media);
const bot = featured.find((p) => !p.data.media);
// Secondary navigation for the feed: browse by topic.
const topics: ReadonlyArray<readonly [string, string]> = [
  ['/projects/junk-factory/', '게임'], ['/projects/discord-economy-bot/', '봇'], ['/research', '주식 연구'], ['/archive', '전체 기록'],
];
---
<BaseLayout title="YARONG — 게임, 봇, 주식 연구" description="Yarong이 만든 게임과 Discord 봇, 날마다 쌓는 주식 연구 기록, 바로 해 보는 반응속도 테스트.">
  <div class="shell home">
    <p class="intro">게임과 봇을 만들고, 주식을 연구하는 야롱입니다.</p>

    <div class="bento">
      {/* Left: things made and played. Right: things to check. Each column stacks at its natural height. */}
      <div class="col col-left">
        {game && <div class="area-lead"><FeaturedProject project={game} /></div>}
        <section class="now" aria-labelledby="now-h">
          <div class="now-head"><h2 id="now-h">지금 하는 일</h2><span class="now-date">{nowUpdated} 기준</span></div>
          <ul class="now-list">
            {NOW.items.map((item) => (
              <li><a href={item.href}>
                <span class="now-top"><strong>{item.project}</strong><span class="now-status">{item.status}</span></span>
                <span class="now-text">{item.text}</span>
              </a></li>
            ))}
          </ul>
        </section>
        <section class="area-play play" aria-labelledby="play-h">
          <span class="signal" aria-hidden="true"></span>
          <div class="play-text">
            <h2 id="play-h">반응속도 테스트</h2>
            <p>초록으로 바뀌는 순간 눌러 5번의 평균을 재 보세요.</p>
          </div>
          <a class="go play-link" href="/play/reaction">테스트하기 <span aria-hidden="true">→</span></a>
        </section>
      </div>
      <div class="col col-right">
        <section class="area-stock" aria-label="오늘의 주식 연구">
          <ResearchToday day={researchDays[0]} performance={performance} />
        </section>
        {bot && <div class="area-bot"><FeaturedProject project={bot} /></div>}
        <section class="area-news news" aria-labelledby="news-h">
          <div class="news-head"><h2 id="news-h">최근 소식</h2><span class="news-sub">반영한 업데이트</span></div>
          {feed.length > 0 ? (
            <ol class="feed">
              {feed.map((item) => (
                <li>
                  <time datetime={item.date.toISOString().slice(0, 10)}>{formatFeedDate(item.date)}</time>
                  <span class="kind" data-kind={item.kind}>{FEED_LABEL[item.kind]}</span>
                  {item.href ? <a href={item.href}>{item.title}</a> : <span>{item.title}</span>}
                </li>
              ))}
            </ol>
          ) : <p class="empty-note">날짜가 확인된 소식이 생기면 여기에 모입니다.</p>}
          <nav class="topics" aria-label="주제별로 보기">
            <span class="topics-label">주제별</span>
            {topics.map(([href, label]) => <a href={href}>{label}</a>)}
          </nav>
        </section>
      </div>
    </div>
  </div>

  <section class="shell more" aria-label="다른 프로젝트와 지난 연구">
    <div>
      <div class="more-head"><h2>다른 프로젝트</h2><a class="go" href="/projects">전체 <span aria-hidden="true">→</span></a></div>
      <ul class="plist">
        {others.map((p) => (
          <li><a href={`/projects/${p.id}/`}>
            <strong>{p.data.title}</strong>
            <span class="psum">{projectSummary(p)}</span>
            {stageLabel(p) && <span class="pstage">{stageLabel(p)}</span>}
          </a></li>
        ))}
      </ul>
    </div>
    <div>
      <div class="more-head"><h2>지난 연구</h2><a class="go" href="/research">연구 기록 <span aria-hidden="true">→</span></a></div>
      <ul class="plist research">
        {pastResearch.map((p) => (
          <li><a href={`/projects/${p.id}/`}>
            <strong>{p.data.title}</strong>
            <span class="psum">{p.data.result ?? projectSummary(p)}</span>
            {stageLabel(p) && <span class="pstage">{stageLabel(p)}</span>}
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="shell contact" aria-labelledby="contact-h">
    <h2 id="contact-h">같이 만들거나, 물어볼 게 있다면</h2>
    <div class="contact-actions">
      <a class="btn btn-primary" href="/contact">문의하기 <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-ghost" href="/portfolio">포트폴리오</a>
    </div>
  </section>
</BaseLayout>
<style>
  .home { padding-top: clamp(.75rem, 2vw, 1.25rem); }
  .intro { margin: 0 0 clamp(.9rem, 1.6vw, 1.25rem); color: var(--muted); font: 500 .95rem/1.4 var(--body); }
  .kicker { margin: 0; color: var(--muted); font: 700 .78rem var(--body); letter-spacing: .06em; }
  .go { display: inline-flex; align-items: center; gap: .35rem; min-height: 2.75rem; font: 700 .92rem var(--body); }
  .go span { transition: transform var(--base) var(--ease); }
  .go:hover span, .go:focus-visible span { transform: translateX(4px); }

  /* Left: things to play. Right: things to check. */
  .bento { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(1.25rem, 2.6vw, 2.5rem); align-items: start; }
  .col { display: flex; flex-direction: column; gap: clamp(1rem, 1.8vw, 1.5rem); min-width: 0; }

  /* 지금 하는 일: a ruled list, no cards. Heading and project names read at least as strongly as 최근 소식. */
  .now { display: grid; gap: .35rem; }
  .now-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .25rem 1rem; padding-bottom: .5rem; border-bottom: 2px solid var(--text); }
  .now-head h2 { margin: 0; font: 800 clamp(1.25rem, 1.8vw, 1.45rem) var(--display); letter-spacing: -.02em; }
  .now-date { color: var(--faint); font: 500 .78rem var(--body); font-variant-numeric: tabular-nums; }
  .now-list { margin: 0; padding: 0; list-style: none; }
  .now-list li + li { border-top: 1px solid var(--line); }
  .now-list a { display: grid; gap: .25rem; padding: .8rem .25rem; transition: background-color var(--fast), padding var(--base) var(--ease); }
  .now-list a:hover, .now-list a:focus-visible { background: rgba(var(--light), .05); padding-inline: .75rem; }
  .now-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; }
  .now-top strong { font: 800 1.15rem/1.3 var(--display); letter-spacing: -.02em; }
  .now-status { color: var(--muted); font: 700 .8rem var(--body); }
  .now-status::before { content: ''; display: inline-block; width: .4rem; height: .4rem; margin-right: .4rem; border-radius: 50%; background: var(--muted); vertical-align: .12em; }
  .now-text { color: var(--muted); font-size: .95rem; line-height: 1.6; }
  .now-list a:hover .now-text, .now-list a:focus-visible .now-text { color: var(--text); }

  /* Mini-game entrance: a quiet row (a ruled line, a small signal dot, one line of text, one link), so it does
     not compete with the featured game. The whole row is clickable through the link. */
  .play { position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .4rem 1rem; padding: .9rem 0; border-block: 1px solid var(--line); }
  .signal { width: .9rem; height: .9rem; border-radius: 50%; background: #B42318; box-shadow: 0 0 0 4px rgba(180, 35, 24, .18); transition: background-color 120ms linear, box-shadow 120ms linear; }
  .play:hover .signal, .play:focus-within .signal { background: #12864A; box-shadow: 0 0 0 4px rgba(18, 134, 74, .22); }
  .play-text { display: grid; gap: .1rem; min-width: 0; }
  .play h2 { margin: 0; font: 800 1.15rem/1.2 var(--display); letter-spacing: -.02em; }
  .play p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.45; }
  .play-link::after { content: ''; position: absolute; inset: 0; }
  .play:hover .play-link span { transform: translateX(4px); }

  /* News: a plain dated list with topic links as secondary navigation. */
  .news { display: grid; align-content: start; gap: .5rem; }
  .news-head h2 { margin: 0; font: 800 1.15rem var(--display); letter-spacing: -.02em; }
  .news-head { display: flex; align-items: baseline; gap: .6rem; }
  .news-sub { color: var(--faint); font: 500 .78rem var(--body); }
  .feed { display: grid; margin: 0; padding: 0; list-style: none; }
  .feed li { display: grid; grid-template-columns: 5.6rem 4.6rem minmax(0, 1fr); align-items: baseline; gap: .6rem; padding: .55rem 0; border-top: 1px solid var(--line); }
  .feed li:last-child { border-bottom: 1px solid var(--line); }
  .feed time { color: var(--faint); font: 500 .8rem var(--body); font-variant-numeric: tabular-nums; }
  .kind { color: var(--muted); font: 700 .75rem var(--body); white-space: nowrap; }
  .kind[data-kind='game'] { color: #F5C451; }
  .kind[data-kind='bot'] { color: #A5ADFF; }
  .kind[data-kind='research'] { color: #7BE3AF; }
  .feed a { display: inline-block; padding-block: .4rem; margin-block: -.4rem; font-weight: 600; background: linear-gradient(currentColor, currentColor) 0 85% / 0 1px no-repeat; transition: background-size var(--base) var(--ease); }
  .feed a:hover, .feed a:focus-visible { background-size: 100% 1px; }
  .empty-note { margin: 0; color: var(--muted); }
  .topics { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; }
  .topics-label { margin-right: .3rem; color: var(--faint); font: 600 .75rem var(--body); }
  .topics a { display: inline-flex; align-items: center; min-height: 2.25rem; padding: 0 .8rem; border-radius: 999px; background: rgba(255, 255, 255, .06); color: var(--muted); font: 600 .82rem var(--body); transition: background-color var(--fast), color var(--fast); }
  .topics a:hover, .topics a:focus-visible { background: var(--text); color: var(--bg); }


  .more { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: clamp(2.5rem, 5vw, 4rem); }
  .more-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: .25rem; }
  .more-head h2 { margin: 0; font: 800 clamp(1.3rem, 2vw, 1.6rem)/1.1 var(--display); letter-spacing: -.03em; }
  .plist { display: grid; margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--line); }
  .plist a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .2rem 1rem; padding: .85rem .25rem; border-top: 1px solid var(--line); transition: background-color var(--fast), padding var(--base) var(--ease); }
  .plist a:hover, .plist a:focus-visible { background: rgba(var(--light), .05); padding-inline: .75rem; }
  .plist strong { font: 700 1.1rem var(--display); letter-spacing: -.02em; }
  .psum { grid-column: 1 / -1; color: var(--muted); font-size: .92rem; line-height: 1.55; }
  .pstage { grid-column: 2; grid-row: 1; color: var(--faint); font-size: .8rem; white-space: nowrap; }

  .contact { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.25rem; margin-top: clamp(3rem, 6vw, 5rem); padding-block: clamp(1.75rem, 3vw, 2.5rem); border-top: 1px solid var(--line); }
  .contact h2 { margin: 0; font: 800 clamp(1.5rem, 3vw, 2.3rem)/1.15 var(--display); letter-spacing: -.04em; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: .6rem; }

  /* Short laptop screens: give the image a little less width (never a crop) so the mini-game entrance stays in view. */
  /* Short laptop screens: give the image a little less width (never a crop). */
  @media (min-width: 1024px) and (max-height: 820px) {
    .bento { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }
  @media (max-width: 1023px) {
    .bento { grid-template-columns: minmax(0, 1fr); row-gap: clamp(1rem, 1.8vw, 1.5rem); }
    .more { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .feed li { grid-template-columns: auto 1fr; gap: .2rem .6rem; }
    .feed li > :last-child { grid-column: 1 / -1; }
    .contact-actions, .contact-actions .btn { width: 100%; }
  }
</style>
