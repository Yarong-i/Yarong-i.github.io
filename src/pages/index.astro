---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeWritings from '../components/home/HomeWritings.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFeature from '../components/home/HomeFeature.astro';
import { sortWritings } from '../utils/writingDates';
const projects = await getCollection('projects');
// Home projects and their order come from the `home` field in each project file.
const homeProjects = projects.filter((p) => p.data.home !== undefined).sort((a, b) => (a.data.home ?? 0) - (b.data.home ?? 0));
const writings = sortWritings(await getCollection('writings', ({ data }) => !data.draft));
---
<BaseLayout>
  <HomeHero />

  {homeProjects.length > 0 && <HomeFeature projects={homeProjects} />}

  <section class="section shell">
    <div class="section-head" data-reveal><div><h2>최근 글</h2></div><a class="arrow-link" href="/writings">Read all</a></div>
    <HomeWritings writings={writings.slice(0, 4)} />
  </section>


  <section class="section shell about-summary">
    <p class="eyebrow" data-reveal>About</p>
    <p data-reveal style="--i: 1">컴퓨터공학과 휴학생입니다. 개발과 주식 연구를 하고, 시를 씁니다.</p>
    <a class="arrow-link" href="/about" data-reveal style="--i: 2">More about Yarong</a>
  </section>
</BaseLayout>
<style>
  /* Home sections sit closer together so the space links the scenes instead of separating them. */
  .section { padding-block: clamp(3.5rem, 6vw, 6rem); }
  .section-head h2 { font-family: var(--body); }
  .about-summary { padding-bottom: 0; }
  .about-summary > p:nth-child(2) { max-width: 1100px; margin: 2rem 0 3rem; font: 500 clamp(1.6rem, 3vw, 2.6rem)/1.35 var(--body); letter-spacing: -.03em; }
</style>
