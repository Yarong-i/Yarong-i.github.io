---
// Home. Order: ① short intro ② today's picks (right under the intro, no motion before the table) ③ 폐품 공장 (C's
// three scenes, compressed, right to left like the real screen) ④ 롱야봇 (one large real screen, three features)
// ⑤ 2D 액션 플랫포머 · 지금 하는 일 ⑥ 최근 업데이트 (done) ⑦ other projects, past research, reaction test, contact.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FactoryGraphic from '../components/home/FactoryGraphic.astro';
import PerformanceChart from '../components/home/PerformanceChart.astro';
import ResearchToday from '../components/ResearchToday.astro';
import LiveTrading from '../components/LiveTrading.astro';
import { STILL } from '../components/home/factoryModel';
import { getPerformance, getResearchDays } from '../utils/research';
import { getFeed, FEED_LABEL, formatFeedDate } from '../utils/news';
import { projectSummary, stageLabel } from '../utils/projects';
import { CONTACT, mailto } from '../data/site';

// Same selection rules as the live Home (coin research is kept off Home).
const projects = (await getCollection('projects')).filter((p) => p.id !== 'coin-research');
const by = (id: string) => projects.find((p) => p.id === id)!;
const game = by('junk-factory');
const bot = by('discord-economy-bot');
const dev = by('2d-action-game');
const isResearch = (p: (typeof projects)[number]) => /연구|Finance/i.test(p.data.category ?? '');
const PAST = new Set(['paused', 'ended', 'finished']);
const isPastResearch = (p: (typeof projects)[number]) => isResearch(p) && PAST.has(p.data.stage ?? '');
const CURRENT = new Set(['live', 'operating', 'in-use', 'active']);
const shown = (p: (typeof projects)[number]) => p.data.featured !== undefined || p.data.wip !== undefined;
const others = [
  ...projects.filter((p) => p.data.home !== undefined && !shown(p) && !isPastResearch(p)).sort((a, b) => a.data.home! - b.data.home!),
  ...projects.filter((p) => p.data.home === undefined && !shown(p) && isResearch(p) && CURRENT.has(p.data.stage ?? '')),
];
const pastResearch = projects.filter((p) => isPastResearch(p) && p.data.featured === undefined).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const researchDays = await getResearchDays();
const performance = await getPerformance();
const feed = await getFeed(3);

const real = game.data.screens[0]!;
// 폐품 공장's current work: the second sentence of its recorded status (nothing else is assumed).
const gameNow = (game.data.statusText ?? '').split(/(?<=다\.)\s+/)[1];
const scenes = [
  { n: '01', h: '모으고.', p: '흩어진 폐품을 모아 투입구로 가져갑니다.' },
  { n: '02', h: '가공하고.', p: '라인을 지나며 가공되고, 판매기에서 돈이 됩니다.' },
  { n: '03', h: '자동화하고.', p: '원격 집하장과 자동 공급 설비가 운반과 생산을 이어 줍니다.' },
];
// 롱야봇: three features, each with its own real screen (different moments, not one trade).
const shot = (src: string) => bot.data.screens.find((x) => x.src.endsWith(src))!;
const feat = (title: string) => bot.data.features.find((f) => f.title === title)!.text;
const botViews = [
  { id: 'news', label: '기업 소식', text: feat('판단에 활용하는 정보'), s: shot('company-news.webp') },
  { id: 'price', label: '주가 확인', text: feat('정각마다 갱신되는 시장'), s: shot('price-alert.webp') },
  { id: 'order', label: '주문 확인', text: feat('Discord에서 거래'), s: shot('buy-confirm.webp') },
];
const devShot = dev.data.screens.find((x) => x.src === dev.data.wip!.image)!;
const makes = [
  { href: '#jf', name: game.data.title, note: 'Roblox 게임' },
  { href: '#bot', name: bot.data.title, note: 'Discord 봇' },
  { href: '#today', name: '주식 연구', note: '날마다 기록' },
  { href: '#dev', name: dev.data.title, note: '제작 중' },
];
---
<BaseLayout title="YARONG — 게임, 봇, 주식 연구" description="Yarong이 만든 게임과 Discord 봇, 날마다 쌓는 주식 연구 기록, 바로 해 보는 반응속도 테스트." htmlClass="home-d"
  fonts="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  {/* ① Intro: short, so today's picks start on the first screen. */}
  <section class="d-intro shell" aria-labelledby="d-h1">
    <div class="d-intro-main">
      <h1 id="d-h1" class="d-word" aria-label="YARONG">{'YARONG'.split('').map((ch, i) => <span class="ch" style={`--i:${i}`} aria-hidden="true">{ch}</span>)}</h1>
      <p class="d-lede">게임과 봇을 만들고, 주식을 연구합니다.</p>
      <div class="d-actions">
        <a class="d-btn d-btn-main" href="/projects">프로젝트 보기</a>
        <a class="d-btn d-btn-line" href="/portfolio">포트폴리오</a>
      </div>
    </div>
    <nav class="d-makes" aria-label="만드는 것">
      <ul>{makes.map((m, i) => <li style={`--i:${i}`}><a href={m.href}><b>{m.name}</b><span>{m.note}</span><i aria-hidden="true">↓</i></a></li>)}</ul>
    </nav>
  </section>

  {/* ② Today's picks: the existing research component and data, no motion in front of it. */}
  <section id="today" class="d-today shell" aria-labelledby="d-today-h">
    <div class="d-today-side">
      <h2 id="d-today-h">오늘의 추천</h2>
      <p>모델마다 고른 최종 1순위 종목과, 그 종목을 사는 기본 전략의 모의 성과입니다.</p>
      <a class="d-link" href="/research#records">날짜별 기록 <span aria-hidden="true">→</span></a>
    </div>
    <div class="d-today-table">
      <ResearchToday day={researchDays[0]} performance={performance} titled />
    </div>
    <div class="d-today-chart">
      <PerformanceChart days={researchDays} performance={performance} />
    </div>
  </section>

  {/* ②-b Real trading record, continuing the picks section. */}
  <LiveTrading />

  {/* ③ 폐품 공장 */}
  <section id="jf" class="d-jf-head shell" aria-labelledby="d-jf-h">
    <p class="d-eyebrow">Roblox 게임 · {stageLabel(game)}</p>
    <h2 id="d-jf-h">{game.data.title}</h2>
    <p class="d-sub">{game.data.tagline}</p>
  </section>
  <section class="d-scroll" aria-label="폐품 공장이 돌아가는 방식" data-scroll>
    <div class="d-sticky">
      <div class="d-copy">
        {scenes.map((s, k) => (
          <div class="d-step" data-step={k} data-active={k === 0 ? 'true' : 'false'}>
            <span class="d-num">{s.n}</span><h3>{s.h}</h3><p>{s.p}</p>
          </div>
        ))}
      </div>
      <div class="d-frame" style="--reveal:0" data-frame>
        <img class="d-real" src={real.src} alt={real.alt} width={real.width} height={real.height} loading="lazy" decoding="async" />
        <div class="d-graphic"><FactoryGraphic p={0} id="live" /></div>
        <p class="d-tag"><span data-tag-g>설명용 그래픽</span><span data-tag-r>실제 게임 화면 · {real.caption}</span></p>
      </div>
    </div>
  </section>
  <section class="d-stills shell" aria-label="폐품 공장이 돌아가는 방식">
    {scenes.map((s, k) => (
      <article class="d-still" data-still>
        <div class="d-still-copy"><span class="d-num">{s.n}</span><h3>{s.h}</h3><p>{s.p}</p></div>
        <figure class="d-still-fig"><FactoryGraphic p={STILL[k]!} id={`still-${k}`} /><figcaption class="d-tag-static">설명용 그래픽</figcaption></figure>
      </article>
    ))}
    <figure class="d-still-real"><img src={real.src} alt={real.alt} width={real.width} height={real.height} loading="lazy" decoding="async" /><figcaption class="d-tag-static">실제 게임 화면 · {real.caption}</figcaption></figure>
  </section>
  {/* Right under the real screen: one line, the current work, the two actions. */}
  <section class="d-jf-after shell" aria-label="폐품 공장 플레이">
    <div>
      <p class="d-strong">지금, Roblox에서 운영 중.</p>
      {gameNow && <p class="d-now"><span>지금 하는 일</span>{gameNow}</p>}
    </div>
    <div class="d-actions">
      {game.data.playUrl && <a class="d-btn d-btn-main" href={game.data.playUrl} target="_blank" rel="noopener">플레이하기<span class="sr-only"> (새 창)</span></a>}
      <a class="d-btn d-btn-line" href={`/projects/${game.id}/`}>프로젝트 소개</a>
    </div>
  </section>

  {/* ④ 롱야봇: one large real screen; three features switch it. */}
  <section id="bot" class="d-bot shell" aria-labelledby="d-bot-h" data-bot data-reveal>
    <div class="d-bot-text">
      <p class="d-eyebrow">Discord 봇 · {stageLabel(bot)}</p>
      <h2 id="d-bot-h">{bot.data.title}</h2>
      <p class="d-sub">{bot.data.tagline}</p>
      <div class="d-bot-tabs" role="group" aria-label="기능 고르기">
        {botViews.map((v, i) => (
          <button type="button" class="d-bot-tab" data-view={v.id} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls="d-bot-screen">
            <b>{v.label}</b><span>{v.text}</span>
          </button>
        ))}
      </div>
      <p class="d-fine">세 화면은 서로 다른 시점의 실제 Discord 화면입니다. {bot.data.notice}</p>
      <a class="d-link" href={`/projects/${bot.id}/`}>프로젝트 소개 <span aria-hidden="true">→</span></a>
    </div>
    <div id="d-bot-screen" class="d-bot-screen">
      {botViews.map((v, i) => (
        <figure class="d-bot-shot" data-shot={v.id} data-active={i === 0 ? 'true' : 'false'}>
          <a href={v.s.src} data-lightbox data-caption={v.s.caption} data-alt={v.s.alt} aria-label={`${v.s.caption} 크게 보기`}>
            <img src={v.s.src} alt={v.s.alt} width={v.s.width} height={v.s.height} loading="lazy" decoding="async" />
          </a>
          <figcaption>실제 화면 · {v.s.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  {/* ⑤ 2D 액션 플랫포머 · 지금 하는 일 */}
  <section id="dev" class="d-dev shell" aria-labelledby="d-dev-h" data-reveal>
    <figure class="d-dev-fig" data-unveil>
      <a href={devShot.src} data-lightbox data-caption={devShot.caption} data-alt={devShot.alt} aria-label={`${devShot.caption} 크게 보기`}>
        <img src={devShot.src} alt={devShot.alt} width={devShot.width} height={devShot.height} loading="lazy" decoding="async" />
      </a>
      <figcaption class="d-tag-static">실제 게임 화면 · {devShot.caption}</figcaption>
    </figure>
    <div class="d-dev-text">
      <p class="d-eyebrow">2D 게임 · {dev.data.wip!.status}</p>
      <h2 id="d-dev-h">{dev.data.title}</h2>
      <p class="d-sub">{dev.data.summary}</p>
      <p class="d-now"><span>지금 하는 일</span>{dev.data.wip!.now}</p>
      <a class="d-link" href={`/projects/${dev.id}/`}>개발 이야기 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {/* ⑥ Updates already applied (in-progress work lives in each project above). */}
  <section class="d-updates shell" aria-labelledby="d-up-h" data-reveal>
    <div class="d-row-head"><h2 id="d-up-h">최근 업데이트</h2><span>반영을 마친 기록</span></div>
    <ol class="d-feed">
      {feed.map((item) => (
        <li>
          <time datetime={item.date.toISOString().slice(0, 10)}>{formatFeedDate(item.date)}</time>
          <span class="d-kind">{FEED_LABEL[item.kind]}</span>
          {item.href ? <a href={item.href}>{item.title}</a> : <span>{item.title}</span>}
        </li>
      ))}
    </ol>
  </section>

  {/* ⑦ The rest. */}
  <section class="d-more shell" aria-label="다른 프로젝트와 지난 연구" data-reveal>
    <div>
      <div class="d-row-head"><h2>다른 프로젝트</h2><a class="d-link" href="/projects">전체 <span aria-hidden="true">→</span></a></div>
      <ul class="d-plist">{others.map((p) => <li><a href={`/projects/${p.id}/`}><strong>{p.data.title}</strong><span class="psum">{projectSummary(p)}</span>{stageLabel(p) && <span class="pstage">{stageLabel(p)}</span>}</a></li>)}</ul>
    </div>
    <div>
      <div class="d-row-head"><h2>지난 연구</h2><a class="d-link" href="/research">연구 기록 <span aria-hidden="true">→</span></a></div>
      <ul class="d-plist">{pastResearch.map((p) => <li><a href={`/projects/${p.id}/`}><strong>{p.data.title}</strong><span class="psum">{p.data.result ?? projectSummary(p)}</span>{stageLabel(p) && <span class="pstage">{stageLabel(p)}</span>}</a></li>)}</ul>
    </div>
  </section>
  <section class="d-play shell" aria-labelledby="d-play-h">
    <div class="d-play-in">
      <span class="d-signal" aria-hidden="true"></span>
      <div><h2 id="d-play-h">반응속도 테스트</h2><p>초록으로 바뀌는 순간 눌러 5번의 평균을 재 보세요.</p></div>
      <a class="d-link d-play-link" href="/play/reaction">테스트하기 <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <section class="d-contact shell" aria-labelledby="d-contact-h">
    <h2 id="d-contact-h">같이 만들거나, 물어볼 게 있다면</h2>
    <a class="d-mail" href={mailto()}>{CONTACT.email}</a>
    <div class="d-actions">
      <a class="d-btn d-btn-main" href="/contact">문의하기</a>
      <a class="d-btn d-btn-line" href="/portfolio">포트폴리오</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { PIECES, pieceAt, sceneAt, clamp } from '../components/home/factoryModel';
  const root = document.documentElement;
  const wide = window.matchMedia('(min-width: 900px)');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  // 롱야봇 features: the buttons switch the one large screen (no timer).
  document.querySelectorAll<HTMLElement>('[data-bot]').forEach((box) => {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[data-view]')];
    const shots = [...box.querySelectorAll<HTMLElement>('[data-shot]')];
    const show = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.view === id)));
      shots.forEach((s) => { s.dataset.active = String(s.dataset.shot === id); s.inert = s.dataset.shot !== id; });
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.view!)));
    show(tabs[0]!.dataset.view!);
  });

  // One-time reveals when a still or the 2D screen comes into view.
  if (!still.matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: .3 });
    document.querySelectorAll<HTMLElement>('[data-still], [data-unveil]').forEach((el) => { el.classList.add('will'); io.observe(el); });
  }

  // 폐품 공장 stage: follows the scroll on wide screens with motion; nothing runs while it is off screen.
  const section = document.querySelector<HTMLElement>('[data-scroll]');
  const frame = document.querySelector<HTMLElement>('[data-frame]');
  const svg = frame?.querySelector<SVGSVGElement>('[data-fg]');
  if (section && frame && svg) {
    const pieces = PIECES.map((_, i) => svg.querySelector<SVGGElement>(`[data-piece="${i}"]`)!);
    const forms = pieces.map((g) => [...g.querySelectorAll<SVGUseElement>('[data-form]')]);
    const stations = [...svg.querySelectorAll<SVGGElement>('[data-st]')];
    const links = [...svg.querySelectorAll<SVGPathElement>('.fg-link')];
    const linkGroup = svg.querySelector<SVGGElement>('[data-links]')!;
    const line = svg.querySelector<SVGGElement>('[data-line]')!;
    const hopper = svg.querySelector<SVGGElement>('[data-hopper]')!;
    const sell = svg.querySelector<SVGGElement>('[data-sell]')!;
    const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
    let last = -1, req = 0, listening = false;
    const draw = () => {
      req = 0;
      const r = section.getBoundingClientRect();
      const p = clamp(-r.top / Math.max(1, r.height - innerHeight));
      if (Math.abs(p - last) < .0005) return;
      last = p;
      pieces.forEach((g, i) => {
        const s = pieceAt(i, p);
        g.setAttribute('transform', `translate(${s.x.toFixed(1)} ${s.y.toFixed(1)}) rotate(${s.r.toFixed(1)}) scale(${s.s.toFixed(3)})`);
        forms[i]!.forEach((u) => u.setAttribute('opacity', u.dataset.form === s.form ? '1' : '0'));
      });
      const sc = sceneAt(p);
      line.setAttribute('opacity', sc.line.toFixed(3));
      hopper.style.setProperty('--lit', sc.hopper.toFixed(3));
      sell.style.setProperty('--lit', sc.sell.toFixed(3));
      stations.forEach((st, k) => st.style.setProperty('--lit', sc.lit[k]!.toFixed(3)));
      linkGroup.setAttribute('opacity', sc.links > 0 ? '1' : '0');
      links.forEach((l) => l.setAttribute('stroke-dashoffset', (1 - sc.links).toFixed(3)));
      frame.style.setProperty('--reveal', sc.reveal.toFixed(3));
      frame.dataset.real = sc.reveal > .5 ? 'true' : 'false';
      steps.forEach((s, k) => (s.dataset.active = String(k === sc.step)));
    };
    const onScroll = () => { if (!req) req = requestAnimationFrame(draw); };
    const watch = new IntersectionObserver(([e]) => {
      if (e?.isIntersecting && !listening) { addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); listening = true; onScroll(); }
      else if (!e?.isIntersecting && listening) { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); listening = false; }
    }, { rootMargin: '100px 0px' });
    const setMode = () => {
      const live = wide.matches && !still.matches;
      root.classList.toggle('d-live', live);
      if (live) { watch.observe(section); last = -1; onScroll(); } else watch.unobserve(section);
    };
    wide.addEventListener('change', setMode);
    still.addEventListener('change', setMode);
    setMode();
  }
</script>

<style>
  :global(html.home-d) {
    --d-ink: #F5F5F7; --d-sub: #A1A1A6; --d-line: #2A2A2E; --d-acc: 62, 230, 222;
    --d-font: 'Pretendard Variable', 'Pretendard', 'IBM Plex Sans KR', -apple-system, sans-serif;
    scroll-padding-top: 4.5rem;
    --home-font: var(--d-font);
  }
  :global(html.home-d body) { background: #000; color: var(--d-ink); font-family: var(--d-font); }
  :global(html.home-d main) { font-family: var(--d-font); }
  .d-eyebrow { margin: 0; color: var(--d-sub); font: 600 .95rem/1.4 var(--d-font); }
  .d-sub { margin: .4rem 0 0; color: var(--d-sub); font: 600 clamp(1.05rem, 1.4vw, 1.3rem)/1.45 var(--d-font); letter-spacing: -.02em; }
  .d-strong { margin: 0; font: 800 clamp(1.4rem, 2.2vw, 1.9rem)/1.2 var(--d-font); letter-spacing: -.035em; }
  .d-now { display: grid; gap: .1rem; margin: .5rem 0 0; color: var(--d-ink); font: 500 1rem/1.55 var(--d-font); }
  .d-now span { color: rgb(var(--d-acc)); font: 700 .8rem var(--d-font); }
  .d-fine { margin: 0; color: var(--d-sub); font: 500 .85rem/1.5 var(--d-font); }
  .d-link { display: inline-flex; align-items: center; gap: .35rem; min-height: 2.75rem; font: 700 .95rem var(--d-font); }
  .d-link span { transition: transform var(--base) var(--ease); }
  .d-link:hover span, .d-link:focus-visible span { transform: translateX(4px); }
  .d-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0 1.4rem; border-radius: 999px; font: 600 1rem var(--d-font); white-space: nowrap;
    transition: transform 160ms var(--ease), background-color 200ms, border-color 200ms; }
  .d-btn-main { background: var(--d-ink); color: #000; }
  .d-btn-main:hover, .d-btn-main:focus-visible { background: #fff; transform: translateY(-1px); }
  .d-btn-line { border: 1px solid #6E6E73; color: var(--d-ink); }
  .d-btn-line:hover, .d-btn-line:focus-visible { border-color: var(--d-ink); transform: translateY(-1px); }
  .d-btn:active { transform: scale(.97); }
  .d-actions { display: flex; flex-wrap: wrap; gap: .6rem; }

  /* ① Intro: about a third of the first screen. */
  .d-intro { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: end; gap: 1.5rem clamp(2rem, 5vw, 4rem); padding-block: clamp(1.4rem, 3.5vh, 2.6rem) clamp(1.2rem, 3vh, 2rem); }
