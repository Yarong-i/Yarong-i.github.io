---
// Home section right under the picks: same grid, type and ruled lines as 오늘의 추천 (no box, no own colours).
import { liveBodyHtml, liveStatus, liveChecked } from '../utils/live-trading-view';
import { getLiveTrading } from '../utils/live-trading-loader';
import { liveTradingConfig } from '../data/live-trading-config';
import '../styles/live-trading.css';
const { snapshot, error } = await getLiveTrading();
// The embedded (last durable) snapshot's time and phase: the browser recomputes the state line from them on load,
// so a page built hours ago still says 장 마감 / 갱신 지연 correctly when the live endpoint cannot be reached.
const embedded = snapshot ? JSON.stringify({ updatedAt: snapshot.updatedAt, operation: snapshot.operation ?? null }) : undefined;
---
<section class="lt shell" id="live-trading" data-endpoint={liveTradingConfig.endpoint} data-snapshot-time={snapshot?.updatedAt} data-embedded={embedded} data-error={error ? "true" : undefined} aria-labelledby="live-title">
  <div class="lt-side">
    <h2 id="live-title">실전 운용</h2>
    <p>어떤 모델이 운용하고, 얼마를 벌었고, 지금 무엇을 기다리는지.</p>
    <p class="lt-conn"><span class="connection">{error ? '기록 확인 불가' : liveStatus(snapshot, Date.now(), liveTradingConfig.staleMs)}</span></p>
    <p class="lt-checked" data-live-checked>{liveChecked(snapshot)}</p>
  </div>
  <div class="lt-body" data-live-body set:html={liveBodyHtml(snapshot, error)} />
</section>
<script>
  import { connectLiveTrading } from '../utils/live-trading-client';
  connectLiveTrading();
</script>
<style>
  /* Mirrors .d-today: title column on the left, content at the picks table's width on the right. */
  .lt { display: grid; grid-template-columns: minmax(16rem, 1fr) minmax(0, 38rem); gap: 1.6rem clamp(2rem, 4vw, 3.5rem); align-items: start; padding-block: 0 clamp(3rem, 7vw, 5rem); }
  .lt-side { display: grid; gap: .4rem; justify-items: start; padding-top: 1rem; border-top: 2px solid var(--text); }
  .lt-side h2 { margin: 0; font: 800 clamp(1.8rem, 2.8vw, 2.4rem)/1.1 var(--d-font, var(--display)); letter-spacing: -.04em; }
  .lt-side p { margin: 0; color: var(--muted); font: 500 .98rem/1.55 var(--d-font, var(--body)); }
  .lt-side .lt-conn { margin-top: .4rem; }
  .connection { color: var(--text); font: 700 .82rem var(--body); }
  .connection::before { content: ''; display: inline-block; width: 6px; height: 6px; margin-right: .45rem; border-radius: 50%; background: var(--faint); vertical-align: .12em; }
  .lt-side .lt-checked { color: var(--faint); font-size: .78rem; }
  .lt-body { display: grid; gap: 1.4rem; padding-top: .9rem; border-top: 2px solid var(--text); min-width: 0; }

  @media (max-width: 1100px) {
    .lt { grid-template-columns: minmax(0, 1fr); }
    .lt-side { grid-template-columns: auto minmax(0, 1fr) auto; align-items: baseline; gap: .2rem 1rem; padding-top: 0; border-top: 0; }
    .lt-side .lt-conn { grid-column: 1 / -1; margin-top: .2rem; }
    .lt-side .lt-checked { grid-column: 1 / -1; }
  }
  @media (max-width: 700px) {
    .lt-side { grid-template-columns: minmax(0, 1fr); }
    .lt-side p:not(.lt-conn):not(.lt-checked) { display: none; }
  }
</style>
