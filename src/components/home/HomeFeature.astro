---
import type { CollectionEntry } from 'astro:content';
import { stageLabel, projectSummary } from '../../utils/projects';
interface Props { projects: CollectionEntry<'projects'>[]; }
const { projects } = Astro.props;
const number = (index: number) => String(index + 1).padStart(2, '0');
---
<section class="feature" aria-labelledby="feature-title" data-feature>
  <div class="feature-surface">
  <div class="shell">
    <div class="feature-head" data-reveal style="--i: 0">
      <h2 id="feature-title">Selected Projects</h2>
      <a class="arrow-link" href="/projects">View all</a>
    </div>
    <div class="pcards">
      {projects.map((project, i) => {
        const stage = stageLabel(project);
        return (
          <article class="pcard lit" data-reveal style={`--i: ${i + 1}`}>
            <p class="pcard-top">
              <span class="pcard-num">{number(i)}</span>
              {stage && <span class="stage">{stage}</span>}
              <span class="pcard-arrow" aria-hidden="true">↗</span>
            </p>
            <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
            {project.data.alias && <p class="pcard-alias">{project.data.alias}</p>}
            <p class="pcard-summary">{projectSummary(project)}</p>
            {project.data.category && <p class="pcard-meta">{project.data.category}</p>}
          </article>
        );
      })}
    </div>
  </div>
  </div>
</section>
<script>
  // Scene change: as the section enters, --open goes 0 → 1 and the silver surface widens from an inset
  // band to the full width. It follows scroll position, so scrolling back up closes it the same way.
  const section = document.querySelector<HTMLElement>('[data-feature]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (section) {
    let frame = 0, near = false;
    const apply = () => {
      frame = 0;
      const top = section.getBoundingClientRect().top, view = window.innerHeight;
      section.style.setProperty('--open', String(Math.min(Math.max((view - top) / (view * 0.85), 0), 1)));
    };
    const schedule = () => { if (!frame && near && !reduced.matches) frame = requestAnimationFrame(apply); };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    new IntersectionObserver(([entry]) => { near = !!entry?.isIntersecting; schedule(); }, { rootMargin: '20% 0px' }).observe(section);
    reduced.addEventListener('change', () => { if (reduced.matches) section.style.removeProperty('--open'); else schedule(); });
  }
</script>
<style>
  /* Scene two: black opens into a bright silver surface. Text colours here are local, not tokens.
     --open (0–1) comes from the script; without it (no JS, reduced motion) the surface is fully open. */
  .feature { --ink: #0B0C10; --ink-muted: #4A505C; --paper: #E4E7ED; --paper-line: #C2C7D1; --paper-node: #F4F6F9;
    --panel-gap: clamp(1rem, 3vw, 3.5rem);
    padding-block: var(--panel-gap); background: var(--bg); color: var(--ink); }
  /* The panel stays narrower than the screen, so black remains on both sides even when fully open.
     Depth comes from light, not borders: a soft highlight from above, a gentle darkening toward the bottom,
     and a one-pixel bright top edge. The open motion (--o) widens it from an inset band and rounds less. */
  .feature-surface { --o: var(--open, 1); width: min(100% - var(--panel-gap) * 2, 100rem); margin-inline: auto; padding-block: clamp(4rem, 7vw, 6.5rem); border-radius: 28px;
    background:
      radial-gradient(ellipse 55% 42% at 50% 0%, rgba(255, 255, 255, .92), transparent 72%),
      linear-gradient(180deg, #E9ECF1 0%, #DFE2E8 58%, #D3D7DE 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9), inset 0 -1px 0 rgba(11, 12, 16, .06);
    clip-path: inset(calc((1 - var(--o)) * 12%) calc((1 - var(--o)) * 7%) round calc(28px + (1 - var(--o)) * 24px)); }
  .feature-surface > .shell { transform: translateY(calc((1 - var(--o)) * 80px)); }
  .feature-head { display: flex; align-items: end; justify-content: space-between; gap: 2rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--paper-line); }
  .feature-head h2 { margin: 0; font: 700 clamp(1.4rem, 2.2vw, 2rem)/1.1 var(--display); letter-spacing: -.03em; }
  .feature .arrow-link { color: var(--ink); }
  .feature :focus-visible { outline-color: var(--ink); }

  /* Four projects with equal weight: a 2 × 2 grid of type-only cards (no screenshots). */
  .pcards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); margin-top: clamp(2rem, 4vw, 3rem); }
  /* Cards are a step brighter than the panel and lit from the top; the edge is a hairline, not a frame. */
  .pcard { display: flex; flex-direction: column; min-height: clamp(15rem, 24vw, 19rem); padding: clamp(1.5rem, 3vw, 2.25rem); border-color: rgba(11, 12, 16, .09); border-radius: 4px;
    background: linear-gradient(180deg, #FAFBFC 0%, #EEF0F4 100%); box-shadow: inset 0 1px 0 #FFFFFF; }
  .feature .lit::before { background: radial-gradient(26rem circle at var(--mx) var(--my), rgba(255, 255, 255, .95), transparent 62%); }
  .feature .lit:hover, .feature .lit:focus-within { border-color: rgba(11, 12, 16, .22); }
  .pcard-top { display: flex; align-items: center; gap: .75rem; margin: 0; }
  .pcard-num { color: var(--ink-muted); font: 600 .75rem/1 var(--body); letter-spacing: .06em; }
  .stage { padding: .32rem .7rem; border: 1px solid var(--ink); border-radius: 999px; font: 600 .78rem/1.1 var(--body); white-space: nowrap; }
  .pcard-arrow { margin-left: auto; color: var(--ink-muted); font-size: 1.05rem; transition: transform var(--base) var(--ease), color var(--fast); }
  .pcard:hover .pcard-arrow, .pcard:focus-within .pcard-arrow { color: var(--ink); transform: translate(3px, -3px); }
  .pcard h3 { margin: clamp(2.25rem, 4.5vw, 3.75rem) 0 0; font: 800 clamp(2rem, 3.6vw, 3.4rem)/1 var(--display); letter-spacing: -.05em; }
  /* The title link covers the card, so each card is one tab stop with a visible outline. */
  .pcard h3 a::after { content: ''; position: absolute; inset: 0; }
  .pcard h3 a:focus-visible { outline: 0; }
  .pcard:has(h3 a:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; }
  .pcard-alias { margin: .5rem 0 0; color: var(--ink-muted); font: 500 .85rem/1.4 var(--body); }
  .pcard-summary { max-width: 34rem; margin: 1rem 0 0; color: var(--ink-muted); font-size: clamp(.98rem, 1.1vw, 1.06rem); line-height: 1.65; transition: color var(--base) var(--ease); }
  .pcard:hover .pcard-summary, .pcard:focus-within .pcard-summary { color: var(--ink); }
  .pcard-meta { margin: auto 0 0; padding-top: 1.25rem; color: var(--ink-muted); font: 500 .74rem/1.4 var(--body); letter-spacing: .06em; text-transform: uppercase; }

  @media (max-width: 760px) {
    .pcards { grid-template-columns: minmax(0, 1fr); }
    .pcard { min-height: 0; }
  }
</style>
