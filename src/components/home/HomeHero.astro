<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-light" aria-hidden="true"></div>
  <div class="shell hero-inner">
    <h1 id="hero-title" class="hero-title"><span>YARONG</span></h1>
    <div class="hero-group">
      <p class="hero-intro">개발하고, 주식을 연구하고, 글을 씁니다.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/projects">Projects <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/writings">Writings <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <a class="arrow-link hero-archive" href="/archive">Archive</a>
    </div>
  </div>
</section>
<script>
  // Two inputs drive the hero through CSS variables, never through a running loop:
  //   pointer (mouse only) → --lx/--ly on the hero (background light) and --tx/--ty on the title (highlight);
  //   scroll → --p from 0 to 1 while the hero is on screen (title and light recede).
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const title = hero?.querySelector<HTMLElement>('.hero-title span');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (hero && title) {
    let frame = 0, visible = true, pointer: PointerEvent | null = null;
    const apply = () => {
      frame = 0;
      if (pointer) {
        const box = hero.getBoundingClientRect(), text = title.getBoundingClientRect();
        hero.style.setProperty('--lx', `${((pointer.clientX - box.left) / box.width) * 100}%`);
        hero.style.setProperty('--ly', `${((pointer.clientY - box.top) / box.height) * 100}%`);
        title.style.setProperty('--tx', `${pointer.clientX - text.left}px`);
        title.style.setProperty('--ty', `${pointer.clientY - text.top}px`);
        pointer = null;
      }
      if (visible) hero.style.setProperty('--p', String(Math.min(Math.max(window.scrollY / hero.offsetHeight, 0), 1)));
    };
    const schedule = () => { if (!frame && !reduced.matches) frame = requestAnimationFrame(apply); };
    hero.addEventListener('pointermove', (event) => { if (event.pointerType === 'mouse') { pointer = event; schedule(); } });
    hero.addEventListener('pointerleave', () => {
      hero.style.removeProperty('--lx'); hero.style.removeProperty('--ly');
      title.style.removeProperty('--tx'); title.style.removeProperty('--ty');
    });
    window.addEventListener('scroll', () => { if (visible) schedule(); }, { passive: true });
    new IntersectionObserver(([entry]) => { visible = !!entry?.isIntersecting; if (visible) schedule(); }).observe(hero);
    reduced.addEventListener('change', () => { if (reduced.matches) hero.style.removeProperty('--p'); else schedule(); });
    schedule();
  }
</script>
<style>
  /* Registered so the browser can ease between pointer positions instead of jumping. */
  @property --lx { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  @property --ly { syntax: '<percentage>'; inherits: true; initial-value: 78%; }
  @property --tx { syntax: '<length-percentage>'; inherits: true; initial-value: 50%; }
  @property --ty { syntax: '<length-percentage>'; inherits: true; initial-value: 100%; }

  .hero { --p: 0; position: relative; display: grid; place-items: center; min-height: max(100svh, 36rem); overflow: clip; text-align: center; transition: --lx 900ms var(--ease), --ly 900ms var(--ease); }

  /* Light from below: a compact bright core under the centre and a much fainter halo around it.
     The mask fades both sides to black, so the light never reads as an even grey haze across the screen.
     The core leans a little toward the pointer (--lx) and, like the halo, recedes with scroll (--p). */
  .hero-light { position: absolute; inset: 0; pointer-events: none; opacity: calc(1 - var(--p) * .9); transform: translateY(calc(var(--p) * 14vh));
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 78%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 22%, #000 78%, transparent 100%); }
  .hero-light::before { content: ''; position: absolute; inset: 0; background:
      radial-gradient(ellipse 24% 21% at calc(50% + (var(--lx) - 50%) * .12) 101%, rgba(var(--light), .52), rgba(var(--light), .2) 44%, transparent 78%),
      radial-gradient(ellipse 56% 40% at 50% 104%, rgba(var(--light), .15), rgba(var(--light), .045) 48%, transparent 76%);
    transform-origin: 50% 100%; animation: light-open 1.6s var(--ease) both; }
  .hero-light::after { content: ''; position: absolute; inset: 0; background: radial-gradient(42rem circle at var(--lx) var(--ly), rgba(var(--light), .16), rgba(var(--light), .05) 40%, transparent 66%); }
  @keyframes light-open { from { opacity: 0; transform: scaleY(.35); } }

  .hero-inner { position: relative; display: flex; flex-direction: column; align-items: center; padding-block: 6rem 4rem; container-type: inline-size;
    transform: translateY(calc(var(--p) * -10vh)) scale(calc(1 - var(--p) * .12)); opacity: calc(1 - var(--p) * 1.15); }

  /* Bold, tight, and lit from below: the fill is brighter at the bottom, with a highlight near the pointer.
     Sized from the content width; YARONG measures about 4.05em in Inter 800 at this tracking. */
  .hero-title { margin: 0; font: 800 min(100cqi / 4.35, 15rem, 30svh)/.88 var(--display); letter-spacing: -.065em; }
  .hero-title span { display: block; padding: 0 .06em .04em 0; color: var(--text); animation: title-in 1.1s var(--ease) both; }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero-title span { color: transparent; -webkit-background-clip: text; background-clip: text; background-image:
        radial-gradient(20rem circle at var(--tx) var(--ty), #FFFFFF, rgba(255, 255, 255, .55) 35%, transparent 72%),
        linear-gradient(to top, #FFFFFF 8%, #DCE2EC 45%, #8C95A8 100%);
      transition: --tx 700ms var(--ease), --ty 700ms var(--ease); }
  }
  @keyframes title-in {
    from { opacity: 0; transform: translateY(38%); letter-spacing: .02em; clip-path: inset(0 0 100% 0); }
    to { opacity: 1; transform: none; letter-spacing: -.065em; clip-path: inset(-20% -10% -20% -10%); }
  }

  /* The intro and buttons sit right under the name so they read as one group. */
  .hero-group { display: flex; flex-direction: column; align-items: center; margin-top: clamp(1.25rem, 3vh, 2rem); animation: group-in 700ms var(--ease) 280ms both; }
  .hero-intro { margin: 0; color: var(--muted); font-size: clamp(1rem, 1.3vw, 1.2rem); line-height: 1.6; }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 1.5rem; }
  .hero-archive { margin-top: 1.25rem; color: var(--muted); }
  .hero-archive:hover, .hero-archive:focus-visible { color: var(--text); }
  @keyframes group-in { from { opacity: 0; transform: translateY(14px); } }

  @media (max-width: 640px) {
    .hero-light { -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%); mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%); }
    .hero-light::before { background:
        radial-gradient(ellipse 55% 22% at 50% 101%, rgba(var(--light), .48), rgba(var(--light), .18) 45%, transparent 78%),
        radial-gradient(ellipse 110% 38% at 50% 104%, rgba(var(--light), .13), transparent 72%); }
    .hero-inner { padding-block: 5rem 3rem; }
    .hero-actions { width: 100%; }
    .hero-actions .btn { flex: 1 1 9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-light, .hero-inner { opacity: 1; transform: none; }
    .hero-light::before, .hero-title span, .hero-group { animation: none; }
  }
</style>
