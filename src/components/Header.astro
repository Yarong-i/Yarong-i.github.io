---
const path = Astro.url.pathname;
// 오늘의 추천: an anchor to today's picks on Home (from every page).
const links: ReadonlyArray<readonly [string, string]> = [['/#today', '오늘의 추천'], ['/projects', '프로젝트'], ['/research', '주식 연구'], ['/play', '미니게임'], ['/contact', '문의']];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="header" data-header>
  <div class="shell inner">
    <a class="logo" href="/" aria-label="YARONG 홈">YARONG</a>
    <nav id="site-nav" class="site-nav" aria-label="주요 메뉴">
      <ul>
        {links.map(([href, label], i) => (
          <li style={`--i: ${i}`}><a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="end">
      <a class="portfolio" href="/portfolio" aria-current={isCurrent('/portfolio') ? 'page' : undefined}>포트폴리오</a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="메뉴 열기"><span class="menu-icon" aria-hidden="true"></span></button>
    </div>
  </div>
</header>
<script>
  // Wide screens show the links inline. On narrow screens they fold into a panel under the bar.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('.menu-button');
  const setOpen = (open: boolean) => {
    button?.setAttribute('aria-expanded', String(open));
    button?.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
    header?.classList.toggle('menu-open', open);
  };
  const isOpen = () => button?.getAttribute('aria-expanded') === 'true';
  button?.addEventListener('click', () => setOpen(!isOpen()));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return;
    setOpen(false);
    button?.focus();
  });
  document.addEventListener('click', (event) => {
    if (isOpen() && header && !header.contains(event.target as Node)) setOpen(false);
  });
  window.matchMedia('(min-width: 761px)').addEventListener('change', (event) => { if (event.matches) setOpen(false); });
  let ticking = false;
  const updateScrolled = () => { ticking = false; header?.classList.toggle('is-scrolled', window.scrollY > 4); };
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(updateScrolled); } }, { passive: true });
  updateScrolled();
</script>
<style>
  .header { position: sticky; top: 0; z-index: 50; background: rgba(9, 10, 13, .82); border-bottom: 1px solid transparent; -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); transition: border-color var(--base) var(--ease); }
  .header.is-scrolled, .header.menu-open { border-bottom-color: var(--line); }
  .inner { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); min-height: 3.75rem; }
  .logo { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 2.75rem; font: 800 1rem var(--display); letter-spacing: .12em; }
  .site-nav ul { display: flex; gap: .25rem; margin: 0; padding: 0; list-style: none; }
  .site-nav a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 .85rem; border-radius: 999px; color: var(--muted); font: 600 .92rem var(--body); transition: color var(--fast), background-color var(--fast); }
  .site-nav a:hover, .site-nav a:focus-visible { color: var(--text); background: rgba(var(--light), .07); }
  .site-nav a[aria-current='page'] { color: var(--text); background: rgba(var(--light), .1); }
  .end { display: flex; align-items: center; gap: .5rem; margin-left: auto; }
  .portfolio { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1.15rem; border-radius: 999px; background: var(--text); color: var(--bg); font: 700 .9rem var(--body); transition: transform var(--fast) var(--ease), background-color var(--fast); }
  .portfolio:hover, .portfolio:focus-visible { background: #fff; }
  .portfolio:active { transform: scale(.96); }
  .menu-button { display: none; }

  @media (max-width: 760px) {
    :global(.js) .menu-button { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; cursor: pointer; }
    .menu-icon { position: relative; width: 1rem; height: .6rem; }
    .menu-icon::before, .menu-icon::after { content: ''; position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; transition: transform var(--base) var(--ease), top var(--base) var(--ease); }
    .menu-icon::before { top: 0; }
    .menu-icon::after { top: calc(100% - 1.5px); }
    .menu-button[aria-expanded='true'] .menu-icon::before { top: calc(50% - .75px); transform: rotate(45deg); }
    .menu-button[aria-expanded='true'] .menu-icon::after { top: calc(50% - .75px); transform: rotate(-45deg); }

    /* Without JavaScript the links wrap under the logo. */
    .inner { flex-wrap: wrap; }
    .site-nav { order: 3; width: 100%; }
    .site-nav ul { flex-wrap: wrap; padding-bottom: .5rem; }
    /* With JavaScript the links live in a panel that drops below the bar. */
    :global(.js) .site-nav { position: absolute; inset: 100% 0 auto; width: auto; padding: .5rem var(--gutter) 1.25rem; background: var(--bg); border-bottom: 1px solid var(--line); clip-path: inset(0 0 100% 0); visibility: hidden; transition: clip-path 420ms var(--ease), visibility 0s linear 420ms; }
    :global(.js) .header.menu-open .site-nav { clip-path: inset(0 0 0 0); visibility: visible; transition: clip-path 480ms var(--ease), visibility 0s; }
    :global(.js) .site-nav ul { display: grid; gap: 0; padding: 0; }
    :global(.js) .site-nav li { border-top: 1px solid var(--line); opacity: 0; transform: translateY(8px); transition: opacity 200ms var(--ease), transform 200ms var(--ease); }
    :global(.js) .header.menu-open .site-nav li { opacity: 1; transform: none; transition: opacity 420ms var(--ease) calc(80ms + var(--i) * 50ms), transform 420ms var(--ease) calc(80ms + var(--i) * 50ms); }
    :global(.js) .site-nav a { display: flex; min-height: 3.5rem; padding: 0; border-radius: 0; font: 700 1.5rem var(--display); letter-spacing: -.03em; background: none; }
    :global(.js) .site-nav a[aria-current='page'] { background: none; }
    :global(.js) .site-nav a[aria-current='page']::after { content: '현재'; margin-left: auto; color: var(--faint); font: 500 .75rem var(--body); }
  }
</style>
